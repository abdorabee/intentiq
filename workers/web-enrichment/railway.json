{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "workers/web-enrichment/Dockerfile",
    "watchPatterns": [
      "workers/web-enrichment/**",
      "lib/signals/crawled.ts",
      "lib/score-evidence.ts",
      "lib/web-enrichment-queue.ts",
      "package.json",
      "package-lock.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS"
  }
}
